# 3. New Function for a Waving Person on the Beach
def draw_waving_person(x, y):
    painter.penup()
    painter.color("black")
    painter.pensize(2)
    # Body
    painter.goto(x, y)
    painter.setheading(90)
    painter.pendown()
    painter.forward(15)
    # Head
    painter.right(90)
    painter.circle(4)
    # Waving Arm
    painter.penup()
    painter.goto(x, y + 10)
    painter.pendown()
    painter.goto(x - 8, y + 18) # Arm up
    # Other Arm
    painter.penup()
    painter.goto(x, y + 10)
    painter.pendown()
    painter.goto(x + 6, y + 5)
    # Legs
    painter.penup()
    painter.goto(x, y)
    painter.pendown()
    painter.goto(x - 4, y - 6)
    painter.penup()
    painter.goto(x, y)
    painter.pendown()
    painter.goto(x + 4, y - 6)

# coconuts
def draw_coconuts(x, y, size=10, spacing=15): #x,y is the center of the cluster & moves entire group
    coco = trtl.Turtle()
    coco.hideturtle()
    coco.speed(0)

    positions = [(0, 0),(spacing, spacing),(-spacing, spacing)]

    for ox, oy in positions:
        coco.penup()
        coco.goto(x + ox, y + oy) #moves each coconut relative to cluster center 
        coco.pendown()
        coco.color('#AA6E46')
        coco.begin_fill()
        coco.circle(size)
        coco.end_fill()

        # dots (these move with the coconut shape)
        for dx, dy in [(3, 5), (-3, 5), (0, 9)]:
            coco.penup()
            coco.goto(x + ox + dx, y + oy + dy)
            coco.pendown()
            coco.color("black")
            coco.begin_fill()
            coco.circle(1.5)
            coco.end_fill()

# palm leaves
def palm_leaf(t, x, y, angle): #x,y is where leaf starts (top of trunk)
    t.penup()
    t.goto(x, y)
    t.setheading(angle)

    t.color('#228B22')
    t.width(3)
    t.pendown()

    # slight base curve
    t.circle(50, 20)

    for i in range(8):
        t.penup()
        t.forward(5)
        t.pendown()

        #zig-zag shape
        t.left(50)
        t.forward(8)
        t.backward(8)
        t.right(100)
        t.forward(8)
        t.backward(8)
        t.left(50)

    t.penup()
    
# island w/ tree
def draw_island(base_x, base_y): #bottom right of island, moves the island, everything on it, & floating coconuts
    t = trtl.Turtle()
    t.hideturtle()
    t.speed(0)

    # half circle from the ground
    t.penup()
    t.goto(base_x, base_y)
    t.setheading(90)
    t.color('#EDC9AF')
    t.begin_fill()

    t.circle(40, 180)
    t.goto(base_x, base_y) 

    t.end_fill()

    #tree
    trunk_x = base_x-40 #moves tree left/right on island
    trunk_y = base_y + 25 #moves tree up/down on island

    t.penup()
    t.goto(trunk_x, trunk_y)
    t.setheading(90)
    t.color('#6E3719')
    t.width(12)
    t.pendown()
    t.forward(55)

    top_x = trunk_x
    top_y = trunk_y + 55 

    # palm crown
    palm_leaf(t, top_x, top_y, 160) #last number is the angle the leaf is at
    palm_leaf(t, top_x, top_y, 130)
    palm_leaf(t, top_x, top_y, 105)
    palm_leaf(t, top_x, top_y, 55)
    palm_leaf(t, top_x, top_y, 30)
    palm_leaf(t, top_x, top_y, 0)
    


    # coconut on tree
    draw_coconuts(top_x, top_y -13, size=8, spacing=12)

    # floating coconuts
    draw_coconuts(base_x + 50, base_y + 10, size=8, spacing=15)
    
    draw_coconuts(tiles_x[6], tiles_y[6]+12, size=8, spacing=15)

    wn.update()

