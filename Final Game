"""
This function creates circles of each color of the whirlpool taking in parameters of the 
circle color (c) and size (s)
"""
def whirlpool_circles(c,s):
  drawer.pencolor(c)
  drawer.fillcolor(c) 
  drawer.begin_fill()
  drawer.circle(s)
  drawer.end_fill()

"""
This function creates a WHIRLPOOL! Takes in X and Y COORDINATES depending where 
you want it.
"""
def whirlpool(x,y):
  # Set up
  drawer.penup()
  drawer.goto(x,y)
  drawer.pendown()
  # Does each circle layer. Do not mind the names too much, the blues just get darker
  whirlpool_circles('#a6dfed',30) # Pastel blue
  drawer.goto(x,y+5)
  whirlpool_circles('#62c8f0',20) # Light blue
  drawer.goto(x,y+10)
  whirlpool_circles('#2bb7ed',10) # Blue
  whirlpool_circles('#0899d1',5) # ocean blue 
  drawer.goto(x,y+15)
  whirlpool_circles('#4867d9',2.5) # Deep blue
  whirlpool_circles('#13319e',1.25) # Dark blue
#for drawing round mountain
def draw_round_mountain(x, y, radius):
    painter.penup()
    painter.goto(x + (radius * 2), y)
    painter.setheading(90)
    painter.pendown()
    painter.fillcolor("forest green")
    painter.begin_fill()
    painter.circle(radius, 180) 
    painter.goto(x + (radius * 2), y)
    painter.end_fill()
#for drawing triangle mountain
def draw_triangle_mountain(x, y, width, height):
    painter.penup()
    painter.goto(x, y)
    painter.pendown()
    painter.fillcolor("forest green")
    painter.begin_fill()
    painter.goto(x + width/2, y + height) 
    painter.goto(x + width, y)            
    painter.goto(x, y)                    
    painter.end_fill()
