import turtle as trtl
import random
import trace
import math
wn = trtl.Screen()
wn.tracer(0)
wn.setup(width=500, height=500)
# Set up
player = trtl.Turtle()
player.penup()
player.goto(0,-210)
player.setheading(90)
player.turtlesize(2)
# Drawer
drawer = trtl.Turtle()
def circle(x,y,r,color): # Takes in x,y coordinates and color
  drawer.goto(x,y)
  drawer.pencolor(color)
  drawer.fillcolor(color)
  drawer.begin_fill()
  drawer.circle(r)
  drawer.end_fill()
def background():
  drawer.hideturtle()
  circle(0,-300,1000,'#609cf7')
  x = 0
  y = 0
  colors = ['#6aa2f7','#79a8f2','#8eb9fa','#a2c4fa','#c0d7fa','#e3eeff'] # darkest to lightest
  radius = [300,250,200,150,100,50]
  for i in range(6):
    circle(x,y,radius[i],colors[i])
    y += 40
# Coin
def coin(x,y):
  coin = trtl.Turtle()
  coin.hideturtle()
  coin.penup()
  coin.penup()
  # outer yellow part
  coin.goto(x,y)
  coin.pendown()
  coin.pencolor('#FFD700') # gold
  coin.fillcolor('#FFD700') # gold
  coin.begin_fill()
  coin.circle(20)
  coin.end_fill()
  # Orange inner part
  coin.goto(x,y+5)
  coin.pencolor('#ffc400') # orange gold
  coin.fillcolor('#ffc400') # orange gold
  coin.begin_fill()
  coin.circle(15)
  coin.end_fill()
  # The square hole
  coin.goto(x,y+11)
  coin.pencolor('#79a8f2') # dull blue
  coin.fillcolor('#79a8f2') # dull blue
  coin.begin_fill()
  coin.circle(8,360,4)
  coin.end_fill()
  # returns the x,y coordinates in a list
  coin_list = [x,y]
  return coin_list
# Shark
def shark():
  shark_head = trtl.Turtle()
  shark_head.penup()
  shark_head.fillcolor('blue')
  shark_head.turtlesize(3)
  shark_head.shape('circle')
  shark_head.goto(random.randint(-250,250),random.randint(-250,250))
  shark_head.setheading(random.randint(0,360))
  x = shark_head.xcor()
  y = shark_head.ycor()
  shark_cors = [x,y]
  return shark_cors
# Player movements
def face_up():
  player.setheading(90)
def face_right():
  player.setheading(0)
def face_down():
  player.setheading(270)
def face_left():
  player.setheading(180)
def move_player():
  player.forward(4)
  x = player.xcor()
  y = player.ycor()
  player_cors = [x,y]
  return player_cors
# Distance calculator using distance formula
def distance_calc():
  player_cors = move_player()
  shark_cors = shark()
  distance = math.sqrt((player_cors[0] - shark_cors[0])**2 + (player_cors[1] - shark_cors[1])**2)
  print(distance)
# EVENTS
background()
for i in range(9):
  coin(random.randint(-240,240),random.randint(-240,240)) 
wn.tracer(1)
distance_calc()
# Moving player
wn.onkeypress(face_up, "Up")
wn.onkeypress(face_right, "Right")
wn.onkeypress(face_down, "Down")
wn.onkeypress(face_left, "Left")
wn.onkeypress(move_player, "g")
wn.listen()



wn.mainloop()
