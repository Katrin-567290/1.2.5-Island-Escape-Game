coin_list = []
def coin(x,y):
  coin = trtl.Turtle()
  coin_list.append(coin)
  coin.penup()
  coin.shape('circle')
  coin.pencolor('#FFD700') # gold
  coin.fillcolor('#FFD700') # gold
  coin.turtlesize(2)
  coin.goto(x,y)
  coin_tuples = (x,y)
  return coin_tuples
# Taking coin positions
def coin_positions():
  coin_positions = []
  for i in range(9):
    coin_pos = coin(random.randint(-240,240),random.randint(-240,240)) 
    coin_positions.append(coin_pos)
  return coin_positions
# Shark
shark_list = []
def shark():
  # Set up
  wn.tracer(0)
  x = random.randint(-250,250)
  y = random.randint(-250,250)
  # Shark tail
  shark_tail = trtl.Turtle()
  shark_tail.penup()
  shark_tail.fillcolor('blue')
  shark_tail.shape('triangle')
  shark_tail.turtlesize(3)
  shark_tail.goto(x-40,y)
  shark_tail.speed(7) # CHANGE WHEN LEVEL IS MADE
  shark_list.append(shark_tail)
  # Shark head
  shark_head = trtl.Turtle()
  shark_head.penup()
  shark_head.fillcolor('blue')
  shark_head.turtlesize(3)
  shark_head.shape('circle')
  shark_head.goto(x,y)
  shark_head.speed(7) # CHANGE WHEN LEVEL IS MADE
  shark_list.append(shark_head)
  # Shark jaw
  shark_jaw = trtl.Turtle()
  shark_jaw.penup()
  shark_jaw.fillcolor('#609cf7')
  shark_jaw.pencolor('#609cf7')
  shark_jaw.turtlesize(1.3)
  shark_jaw.shape('triangle')
  shark_jaw.setheading(180)
  shark_jaw.goto(x+22,y)
  shark_jaw.speed(7) # CHANGE WHEN LEVEL IS MADE
  shark_list.append(shark_jaw)
  x = shark_head.xcor()
  y = shark_head.ycor()
  shark_cors = [x,y]
  wn.tracer(1)
  # moving shark
  for i in range(2): # CHANGE WHEN TIMER IS MADE
    new_x = random.randint(-250,250)
    new_y = random.randint(-250,250)
    print(new_x,new_y)
    current_x = shark_cors[0]
    current_y = shark_cors[1]
    # Using the slope formula (ish) to move the shark unit by unit
    x_move = new_x - current_x
    y_move = new_y - current_y
    if abs(y_move) > abs(x_move):
      x_change = x_move/abs(y_move)
      y_change = y_move/abs(y_move)
      total = abs(y_move)
    if abs(x_move) >= abs(y_move):
      x_change = x_move/abs(x_move)
      y_change = y_move/abs(x_move)
      total = abs(x_move)
    for i in range(total):
      for i in range(3):
        shark_list[i].goto(shark_list[i].xcor()+x_change,shark_list[i].ycor()+y_change)
# Player movements
def face_up():
  player.setheading(90)
def face_right():
  player.setheading(0)
def face_down():
  player.setheading(270)
def face_left():
  player.setheading(180)

# Distance calculator using distance formula
coin_cors = coin_positions()
def distance_calc(x,y):
  player_cors = [x,y]
  # Distance from player to coin
  distance_pc = []
  for i in range(len(coin_list)):
    coin_dis = math.sqrt((player_cors[0] - coin_cors[i][0])**2 + (player_cors[1] - coin_cors[i][1])**2)
    distance_pc.append(coin_dis)
    # Detecting if the turtle is close enough to the coin
  for i in range(len(distance_pc)):
    if distance_pc[i] <= 10:
      coin_list[i].hideturtle()
      coin_list.pop(i)
      coin_cors.pop(i)
      break
  # Distance from player to the shark
  shark_x = shark_list[1].xcor()
  shark_y = shark_list[1].ycor()
  shark_cor = [shark_x,shark_y]
  shark_dis = math.sqrt((player_cors[0] - shark_cor[0])**2 + (player_cors[1] - shark_cor[1])**2)
  if shark_dis <= 40:
    print("You got eaten by the shark") # CHANGE WHEN TIMER IS ADDED 
  if coin_list == []:
    print("Congrats! You got all the coins!")
    
  # detecting if the player touches the coin

def move_player():
  player.forward(4)
  x = player.xcor()
  y = player.ycor()
  distance_calc(x,y)

