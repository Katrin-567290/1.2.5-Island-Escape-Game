# Timer
# The timer
def countdown():
  global timer, timer_up
  counter.clear()
  if timer == 0:
    counter.write("Time's Up", font=font_setup) 
    timer_up = True 
    drawer.clear()
    for i in range(3):
      shark_list[i].hideturtle()
    for i in range(len(coin_list)):
      coin_list[i].hideturtle()
    player.hideturtle()
    counter.clear()
    wn.clear() 
    total_points = len(points) * 5 + t_size_pt + shark_size_pt
    final_screen(total_points)
  else:
    counter.write("Timer: " + str(timer), font=font_setup)
    timer -= 1
    counter.getscreen().ontimer(countdown, counter_interval) 
# Drawer
drawer = trtl.Turtle()
def circle(x,y,r,color): # Takes in x,y coordinates and color
  drawer.goto(x,y)
  drawer.pencolor(color)
  drawer.fillcolor(color)
  drawer.begin_fill()
  drawer.circle(r)
  drawer.end_fill()
def background():
  drawer.hideturtle()
  circle(0,-300,1000,'#609cf7')
  x = 0
  y = 0
  colors = ['#6aa2f7','#79a8f2','#8eb9fa','#a2c4fa','#c0d7fa','#e3eeff'] # darkest to lightest
  radius = [300,250,200,150,100,50]
  for i in range(6):
    circle(x,y,radius[i],colors[i])
    y += 40
# Coin

coin_list = []
def coin(x,y):
  coin = trtl.Turtle()
  coin_list.append(coin)
  coin.penup()
  coin.shape('circle')
  coin.pencolor('#FFD700') # gold
  coin.fillcolor('#FFD700') # gold
  coin.turtlesize(2)
  coin.goto(x,y)
  coin_tuples = (x,y)
  return coin_tuples
# Taking coin positions
def coin_positions():
  coin_positions = []
  for i in range(9):
    coin_pos = coin(random.randint(-240,240),random.randint(-240,240)) 
    coin_positions.append(coin_pos)
  return coin_positions

# Shark
shark_list = []
def shark():
  # Set up
  wn.tracer(0)
  x = random.randint(-250,250)
  y = random.randint(-200,250)
  # Shark tail
  shark_tail = trtl.Turtle()
  shark_tail.penup()
  shark_tail.fillcolor('blue')
  shark_tail.shape('triangle')
  shark_tail.turtlesize(shark_size)
  shark_tail.goto(x-shark_size*10,y)
  shark_tail.speed(7) # CHANGE WHEN LEVEL IS MADE
  shark_list.append(shark_tail)
  # Shark head
  shark_head = trtl.Turtle()
  shark_head.penup()
  shark_head.fillcolor('blue')
  shark_head.turtlesize(shark_size)
  shark_head.shape('circle')
  shark_head.goto(x,y)
  shark_head.speed(7) # CHANGE WHEN LEVEL IS MADE
  shark_list.append(shark_head)
  # Shark jaw
  shark_jaw = trtl.Turtle()
  shark_jaw.penup()
  shark_jaw.fillcolor('#609cf7')
  shark_jaw.pencolor('#609cf7')
  # perfecting jaw position
  if shark_size == 3:
    shark_jaw.turtlesize(shark_size/2)
    shark_jaw.goto(x+22,y)
  else: 
    shark_jaw.turtlesize(shark_size/2)
    shark_jaw.goto(x+shark_size*7,y)
  shark_jaw.shape('triangle')
  shark_jaw.setheading(180)
  shark_jaw.speed(7) # CHANGE WHEN LEVEL IS MADE
  shark_list.append(shark_jaw)
  wn.tracer(1)
  # moving shark
  while timer != 0: 
    new_x = random.randint(-250,250)
    new_y = random.randint(-250,250)
    current_x = shark_head.xcor()
    current_y = shark_head.ycor()
    # Using the slope formula (ish) to move the shark unit by unit
    x_move = new_x - current_x
    y_move = new_y - current_y
    if abs(y_move) > abs(x_move):
      x_change = x_move/abs(y_move)
      y_change = y_move/abs(y_move)
      total = abs(y_move)
    if abs(x_move) >= abs(y_move):
      x_change = x_move/abs(x_move)
      y_change = y_move/abs(x_move)
      total = abs(x_move)
    for i in range(int(total)):
      for i in range(3):
        shark_list[i].goto(shark_list[i].xcor()+x_change,shark_list[i].ycor()+y_change)
# Player movements
def face_up():
  player.setheading(90)
def face_right():
  player.setheading(0)
def face_down():
  player.setheading(270)
def face_left():
  player.setheading(180)

# Distance calculator using distance formula
coin_cors = coin_positions()
def distance_calc(x,y):
  player_cors = [x,y]
  # Distance from player to coin
  distance_pc = []
  for i in range(len(coin_list)):
    coin_dis = math.sqrt((player_cors[0] - coin_cors[i][0])**2 + (player_cors[1] - coin_cors[i][1])**2)
    distance_pc.append(coin_dis)
    # Detecting if the turtle is close enough to the coin
  for i in range(len(distance_pc)):
    if distance_pc[i] <= 10:
      points.append(5)
      coin_list[i].hideturtle()
      coin_list.pop(i)
      coin_cors.pop(i)
      break
  # Distance from player to the shark
  shark_x = shark_list[1].xcor()
  shark_y = shark_list[1].ycor()
  shark_cor = [shark_x,shark_y]
  shark_dis = math.sqrt((player_cors[0] - shark_cor[0])**2 + (player_cors[1] - shark_cor[1])**2)
  if shark_dis <= (shark_size *15):
    print("You got eaten by the shark")
    drawer.clear()
    for i in range(3):
      shark_list[i].hideturtle()
    for i in range(len(coin_list)):
      coin_list[i].hideturtle()
    player.hideturtle()
    counter.clear()
    wn.clear()
    total_points = len(points) * 5 + t_size_pt + shark_size_pt
    final_screen(total_points)
  if coin_list == []:
    print("Congrats! You got all the coins!")
    drawer.clear()
    for i in range(3):
      shark_list[i].hideturtle()
    for i in range(len(coin_list)):
      coin_list[i].hideturtle()
    player.hideturtle()
    counter.clear()
    wn.clear()
    total_points = len(points) * 5 + t_size_pt + shark_size_pt
    final_screen(total_points)
    return total_points # RETURNS THE TOTAL POINTS
# Final screen
def final_screen(total_points):
  writer = trtl.Turtle()
  writer.hideturtle()
  writer.penup()
  global player_name
  player_name = player_name.lower() # Everything lowercase
  player_name = player_name.title() # Captialize first letter
  
  player_name_list = list(player_name)
  if len(player_name_list) > 8:
    for i in range(len(player_name_list) - 8):
      player_name_list.pop()
    player = "".join(player_name_list)
    dots = "..."
    player_name = player + dots
  else:
    player_name = "".join(player_name_list)
  writer.goto(-150,0)
  writer.write("Congrats! " + player_name + " got " + str(total_points) + " points!", font=("Arial", 19))

def move_player():
  player.forward(4)
  x = player.xcor()
  y = player.ycor()
  distance_calc(x,y)


def game():
  global player_name
  global t_shape
  global t_size
  global shark_size
  player_name = input("What is your name?")
  t_shape = input("What shape do you want your turtle to be? Choices are arrow, turtle, circle, square, triangle, classic")
  t_size = int(input("What size do you want your turtle to be? Choose from interval [2,5]"))
  shark_size = int(input("What size do you want the shark to be? Choose from interval [3,6]"))
  making_player()
  # EVENTS
  background()
  wn.tracer(1)
  # Moving player
  wn.onkeypress(face_up, "Up")
  wn.onkeypress(face_right, "Right")
  wn.onkeypress(face_down, "Down")
  wn.onkeypress(face_left, "Left")
  wn.onkeypress(move_player, "g")
  wn.listen()
  countdown()
  shark()
wn.onkeypress(game, "s")
wn.listen()


wn.mainloop()
