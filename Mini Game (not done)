coin_list = []
def coin(x,y):
  coin = trtl.Turtle()
  coin_list.append(coin)
  coin.penup()
  coin.shape('circle')
  coin.pencolor('#FFD700') # gold
  coin.fillcolor('#FFD700') # gold
  coin.turtlesize(2)
  coin.goto(x,y)
  coin_tuples = (x,y)
  return coin_tuples
# Taking coin positions
def coin_positions():
  coin_positions = []
  for i in range(9):
    coin_pos = coin(random.randint(-240,240),random.randint(-240,240)) 
    coin_positions.append(coin_pos)
  return coin_positions
# Shark
def shark():
  shark_head = trtl.Turtle()
  shark_head.penup()
  shark_head.fillcolor('blue')
  shark_head.turtlesize(3)
  shark_head.shape('circle')
  shark_head.goto(random.randint(-250,250),random.randint(-250,250))
  shark_head.setheading(random.randint(0,360))
  x = shark_head.xcor()
  y = shark_head.ycor()
  shark_cors = [x,y]
  return shark_cors
# Player movements
def face_up():
  player.setheading(90)
def face_right():
  player.setheading(0)
def face_down():
  player.setheading(270)
def face_left():
  player.setheading(180)

# Distance calculator using distance formula
coin_cors = coin_positions()
shark_cors = shark()
def distance_calc(x,y):
  player_cors = [x,y]
  distance_ps = math.sqrt((player_cors[0] - shark_cors[0])**2 + (player_cors[1] - shark_cors[1])**2)
  distance_pc = []
  for i in range(len(coin_list)):
    coin_dis = math.sqrt((player_cors[0] - coin_cors[i][0])**2 + (player_cors[1] - coin_cors[i][1])**2)
    distance_pc.append(coin_dis)
  for i in range(len(distance_pc)):
    if distance_pc[i] <= 10:
      coin_list[i].hideturtle()
      coin_list.pop(i)
      distance_pc.pop(i)
      break
  print(distance_pc)
      
    
  # detecting if the player touches the coin

def move_player():
  player.forward(4)
  x = player.xcor()
  y = player.ycor()
  distance_calc(x,y)

